# Copy to .env before starting Docker Compose.
# Application port on this computer; PostgreSQL is internal to Compose.
APP_PORT=8000
POSTGRES_DB=eventmatch
POSTGRES_USER=eventmatch
POSTGRES_PASSWORD=replace_with_local_password
# Leave AI_MODULE empty for backend fallback, or set AI_MODULE=ai_module
# to use the teammate's async ranking module included in this repository.
AI_MODULE=
AI_VERSION=v1
# Bump AI_VERSION whenever the prompt/evidence/ranking behavior changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MODE=auto
AI_TIMEOUT_SECONDS=5
