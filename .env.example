# Copy to .env before starting Docker Compose.
# Application port on this computer; PostgreSQL is internal to Compose.
APP_PORT=8000
POSTGRES_DB=eventmatch
POSTGRES_USER=eventmatch
POSTGRES_PASSWORD=replace_with_local_password
# Reserved for the next AI integration stage; not used by the bootstrap app yet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MODE=auto
AI_TIMEOUT_SECONDS=5
